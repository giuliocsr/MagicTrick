{
  "manifest_version": 2,
  "version": "1.0.0",
  "author": "Giulio Golinelli",
  "name": "MagicTrick ▾ (dropdown)",
  "description": "Dropdown companion for MagicTrick: adds the ▾ split-button menu next to the wand. Requires MagicTrick.",

  "browser_specific_settings": {
    "gecko": {
      "id": "magictrick-menu@giuliocsr.github.io",
      "strict_min_version": "128.0"
    }
  },

  "icons": {
    "16": "icons/wand-chevron-16.png",
    "32": "icons/wand-chevron-32.png",
    "64": "icons/wand-chevron-64.png"
  },

  "background": {
    "scripts": ["background.js"]
  },

  "compose_action": {
    "default_title": "MagicTrick ▾ — menu",
    "default_label": "▾",
    "default_icon": {
      "16": "icons/wand-chevron-16.png",
      "32": "icons/wand-chevron-32.png",
      "64": "icons/wand-chevron-64.png"
    },
    "type": "menu"
  },

  "permissions": ["menus"]
}
